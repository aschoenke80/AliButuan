{
    "version": 2,
    "framework": null,
    "buildCommand": "npm run build",
    "outputDirectory": "public",
    "functions": {
        "api/index.php": {
            "runtime": "vercel-php@0.7.2"
        }
    },
    "routes": [
        {
            "src": "/(.*\\.(css|js|ico|txt|png|jpg|jpeg|gif|svg|webp|woff|woff2|ttf|eot))",
            "dest": "/$1"
        },
        {
            "src": "/(.*)",
            "dest": "/api/index.php"
        }
    ],
    "env": {
        "APP_KEY": "base64:RBOtpcEpShm/S2rO0VFjl4xW/Dic1CqnQd0oXM1qiY8=",
        "APP_ENV": "local",
        "APP_DEBUG": "true",
        "LOG_CHANNEL": "stderr",
        "DB_CONNECTION": "sqlite",
        "DB_DATABASE": "/tmp/database.sqlite",
        "CACHE_DRIVER": "array",
        "SESSION_DRIVER": "cookie"
    }
}
